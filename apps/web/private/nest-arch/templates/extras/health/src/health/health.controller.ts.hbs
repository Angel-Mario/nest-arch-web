import { Controller, Get } from "@nestjs/common";
import { HealthCheck, HealthCheckService } from "@nestjs/terminus";
{{#if isBetterAuth}}
import { AllowAnonymous } from "@thallesp/nestjs-better-auth";
{{/if}}
{{#if hasDatabase}}
import { DbService } from "../database/db.service.js";
{{#if (and hasMongodb useTypeorm)}}
import { Todo } from "../database/entities/todo.entity.js";
{{/if}}
{{#if useDrizzle}}
import { sql } from "drizzle-orm";
{{/if}}
{{/if}}

{{#if isBetterAuth}}
@AllowAnonymous()
{{/if}}
@Controller("health")
export class HealthController {
  constructor(
    private readonly health: HealthCheckService{{#if hasDatabase}},
    private readonly db: DbService{{/if}}
  ) {}

  @Get()
  @HealthCheck()
  check() {
    return this.health.check([
      () => ({ app: { status: "up" } }),
      {{#if hasDatabase}}
      async () => {
        try {
        {{#if (and isPrisma8 hasMongodb)}}
        {{#if hasTodoExample}}
          await this.db.prisma.orm.todos.limit(1).first();
        {{else}}
          await this.db.prisma.connect();
        {{/if}}
        {{else if hasMongodb}}
          {{#if usePrisma}}
          await this.db.raw.mongo.$runCommandRaw({ ping: 1 });
          {{else if useTypeorm}}
          await this.db.typeorm.getMongoRepository(Todo).countDocuments({}, { limit: 1 });
          {{else}}
          await this.db.raw.mongo.command({ ping: 1 });
          {{/if}}
        {{else if isPrisma8}}
        {{#if hasTodoExample}}
        await this.db.prisma.orm.public.Todo.all();
        {{else}}
        await this.db.prisma.connect();
        {{/if}}
        {{else if usePrisma}}
        await this.db.prisma.$queryRaw`SELECT 1`;
        {{else if useDrizzle}}
        {{#if hasSqlite}}
        await this.db.drizzle.get(sql`SELECT 1`);
        {{else}}
        await this.db.drizzle.execute(sql`SELECT 1`);
        {{/if}}
        {{else if useTypeorm}}
        await this.db.typeorm.query("SELECT 1");
        {{else}}
        await this.db.raw.sql.query("SELECT 1");
        {{/if}}
        return { db: { status: "up" } };
        } catch {
          return { db: { status: "down" } };
        }
      },
      {{/if}}
    ]);
  }
}
