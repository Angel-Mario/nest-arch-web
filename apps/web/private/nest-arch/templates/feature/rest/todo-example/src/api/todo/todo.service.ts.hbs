import { BadRequestException, Injectable, NotFoundException } from "@nestjs/common";

import { DbService } from "../../database/db.service.js";
import type { Models } from "../../prisma/contract.js";
import { CreateTodoDto } from "./dto/create-todo.dto.js";
import { UpdateTodoDto } from "./dto/update-todo.dto.js";

type Todo = Omit<Models.unbound_Todo, "_id"> & { id: string };

function assertMongoId(id: string): void {
  if (!/^[a-f0-9]{24}$/iu.test(id)) {
    throw new BadRequestException("Invalid todo identifier");
  }
}

const serialize = ({ _id, ...todo }: Models.unbound_Todo): Todo => ({
  ...todo,
  id: _id,
});

@Injectable()
export class TodoService {
  constructor(private readonly db: DbService) {}

  async findAll({{#if hasAuth}}ownerId: string{{/if}}): Promise<Todo[]> {
    const todos: Todo[] = [];
    const query = {{#if hasAuth}}this.db.prisma.orm.todos.where({ authorId: ownerId }){{else}}this.db.prisma.orm.todos{{/if}};
    for await (const todo of query.limit(100).all()) {
      todos.push(serialize(todo));
    }
    return todos;
  }

  async create(input: CreateTodoDto{{#if hasAuth}}, ownerId: string{{/if}}): Promise<Todo> {
    const todo = await this.db.prisma.orm.todos.create({
      {{#if hasAuth}}authorId: ownerId,{{/if}}
      completed: input.completed ?? false,
      ...(input.description === undefined ? {} : { description: input.description }),
      title: input.title,
    });
    return serialize(todo);
  }

  async update(id: string, input: UpdateTodoDto{{#if hasAuth}}, ownerId: string{{/if}}): Promise<Todo> {
    assertMongoId(id);
    const todo = await this.db.prisma.orm.todos.where({ _id: id{{#if hasAuth}}, authorId: ownerId{{/if}} }).update(input);
    if (!todo) {
      throw new NotFoundException("Todo not found");
    }
    return serialize(todo);
  }

  async delete(id: string{{#if hasAuth}}, ownerId: string{{/if}}): Promise<{ message: string }> {
    assertMongoId(id);
    const todo = await this.db.prisma.orm.todos.where({ _id: id{{#if hasAuth}}, authorId: ownerId{{/if}} }).delete();
    if (!todo) {
      throw new NotFoundException("Todo not found");
    }
    return { message: "Todo deleted successfully" };
  }
}
