{
  "name": "{{projectName}}",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types"{{#if hasUltracite}},
    "check": "ultracite check"{{/if}}{{#if hasHusky}},
    "prepare": "husky"{{/if}}
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "catalog:",
    {{#if hasHusky}}"husky": "^9.1.7",{{/if}}
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  }{{#if hasHusky}},
  "lint-staged": {
    "*": [
      "oxlint",
      "oxfmt --write"
    ]
  }{{/if}},
  "packageManager": {{#if isPnpm}}"pnpm@10.33.0"{{else if isYarn}}"yarn@4.6.0"{{else if isBun}}"bun@1.3.14"{{else}}undefined{{/if}}
}
