      throw new NotFoundException("Todo not found");
    }
    const todo = await repository.findOneBy({ id });
    if (!todo) {
      throw new NotFoundException("Todo not found");
    }
    return todo;
{{else if useDrizzle}}
{{#if hasSqlserver}}
    const [todo] = await this.db.drizzle.update(schema.todos).set(input).output().where(eq(schema.todos.id, Number(id)));
    if (!todo) {
      throw new NotFoundException("Todo not found");
    }
{{else if hasMysql}}
    await this.db.drizzle.update(schema.todos).set(input).where(eq(schema.todos.id, Number(id)));
    const [todo] = await this.db.drizzle.select().from(schema.todos).where(eq(schema.todos.id, Number(id)));
    if (!todo) {
      throw new NotFoundException("Todo not found");
    }
{{else}}
    const [todo] = await this.db.drizzle.update(schema.todos).set(input).where(eq(schema.todos.id, Number(id))).returning();
{{/if}}
    return todo;
{{/if}}
  }

  async delete(id: string) {
{{#if isPrisma8}}
    await this.db.prisma.orm.public.Todo.where({ id: Number(id) }).delete();
{{else if usePrisma}}
{{#if (and hasMongodb (not isPrisma8))}}
    this.assertMongoId(id);
    const existingTodo = await this.db.prisma.todo.findUnique({ where: { id } });
    if (!existingTodo) {
      throw new NotFoundException("Todo not found");
    }
{{/if}}
    await this.db.prisma.todo.delete({ where: { id } });
{{else if (and hasSqlserver useRawSql)}}
    const [todo] = await this.db.sql.query<{ id: number }>(
      'DELETE FROM todos OUTPUT DELETED.id WHERE id = ?',
      [id]
    );
    if (!todo) {
      throw new NotFoundException("Todo not found");
    }
{{else if useTypeorm}}
    await this.db.typeorm.getRepository(Todo).delete(id);
{{else if useDrizzle}}
{{#if hasSqlserver}}
    const [todo] = await this.db.drizzle.delete(schema.todos).output().where(eq(schema.todos.id, Number(id)));
    if (!todo) {
      throw new NotFoundException("Todo not found");
    }
{{else}}
    await this.db.drizzle.delete(schema.todos).where(eq(schema.todos.id, Number(id)));
{{/if}}
{{/if}}
    return { message: "Todo deleted successfully" };
  }
{{/if}}
{{else}}
  findAll({{#if hasAuth}}authorId: string{{/if}}) {
{{#if hasAuth}}
    return this.todos.filter((todo) => todo.authorId === authorId);
{{else}}
    return [...this.todos];
{{/if}}
  }

  create(input: CreateTodoDto{{#if hasAuth}}, authorId: string{{/if}}) {
    const id = String(this.nextId);
    this.nextId += 1;
    const todo = { id, ...input{{#if hasAuth}}, authorId{{/if}} };
    this.todos.push(todo);
    return todo;
  }

  update(id: string, input: UpdateTodoDto{{#if hasAuth}}, authorId: string{{/if}}) {
    const todo = this.todos.find((item) => item.id === id{{#if hasAuth}} && item.authorId === authorId{{/if}});
    if (!todo) {
      throw new NotFoundException("Todo not found");
    }
    Object.assign(todo, input);
    return todo;
  }

  delete(id: string{{#if hasAuth}}, authorId: string{{/if}}) {
    const index = this.todos.findIndex((item) => item.id === id{{#if hasAuth}} && item.authorId === authorId{{/if}});
    if (index === -1) {
      throw new NotFoundException("Todo not found");
    }
    this.todos.splice(index, 1);
    return { message: "Todo deleted successfully" };
  }
{{/if}}
}

