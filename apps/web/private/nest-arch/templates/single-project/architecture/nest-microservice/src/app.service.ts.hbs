import { Injectable } from "@nestjs/common";
{{#if (and hasDatabase hasTodoExample)}}
import { RpcException } from "@nestjs/microservices";
import { TodoService } from "./api/todo/todo.service.js";
{{/if}}

@Injectable()
export class AppService {
  {{#if hasMessageTransport}}
  private readonly auditEvents = new Map<
    string,
    { id: string; payload: Record<string, unknown>; source: string{{#if isNatsPassport}}; principalId: string{{/if}} }
  >();

  recordAuditEvent(event: {
    id: string;
    payload: Record<string, unknown>;
    source: string;
    {{#if isNatsPassport}}principalId: string;{{/if}}
  }): void {
    this.auditEvents.set(event.id, event);
  }

  getAuditEvent(
    id: string{{#if isNatsPassport}}, ownerId: string{{/if}}
  ): { id: string; payload: Record<string, unknown>; source: string{{#if isNatsPassport}}; principalId: string{{/if}} } | null {
    const event = this.auditEvents.get(id);
    {{#if isNatsPassport}}
    return event?.principalId === ownerId ? event : null;
    {{else}}
    return event ?? null;
    {{/if}}
  }

  {{/if}}
  {{#if (and hasDatabase hasTodoExample)}}
  constructor(private readonly todos: TodoService) {}

  createTodo(data: { title: string }{{#if isNatsPassport}}, ownerId: string{{/if}}) {
    if (typeof data?.title !== "string" || data.title.trim().length === 0) {
      throw new RpcException({ code: 3, message: "A non-empty title is required" });
    }
    return this.todos.create({ completed: false, title: data.title }{{#if isNatsPassport}}, ownerId{{/if}});
  }

  findTodos({{#if isNatsPassport}}ownerId: string{{/if}}) {
    return this.todos.findAll({{#if isNatsPassport}}ownerId{{/if}});
  }

  {{/if}}
  getHello(): string {
    return "Hello World!";
  }

  handlePing(): string {
    return "pong";
  }

  handleLog(data: Record<string, unknown>): { received: Record<string, unknown> } {
    return { received: data };
  }
}
