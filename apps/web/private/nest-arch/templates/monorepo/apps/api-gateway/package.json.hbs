{
  "name": "@repo/api-gateway",
  "version": "0.0.1",
  "private": true,
  "description": "{{description}}",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"{{#if hasUltracite}},
    "check": "ultracite check",
    "fix": "ultracite fix --ignore-pattern migrations/**"{{/if}}{{#if hasHusky}},
    "prepare": "husky"{{/if}}
  },
  "dependencies": {
    "@nestjs/common": "next",
    "@nestjs/core": "next",
    "@nestjs/platform-{{httpProvider}}": "next",
    "@repo/env": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "next",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "next",
    "@nestjs/testing": "next",
    "@repo/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "4.1.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "catalog:",
    {{#if hasUltracite}}"ultracite": "7.8.0",{{/if}}
    "vitest": "^4.1.2"
  }
}
