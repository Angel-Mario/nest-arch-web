    await call("findAll").expect(401);
    const signIn = await request(getRequestTarget(server)).post("/api/auth/sign-in/social")
      .set("Origin", "http://localhost:3000")
      .send({ callbackURL: "/", provider: "scenario-oidc" }).expect(200);
    const authorization = new URL(signIn.body.url);
    const providerResponse = await request(oidcServer)
      .get(`${authorization.pathname}${authorization.search}`).expect(302);
    const callback = new URL(providerResponse.headers.location);
    const session = await request(getRequestTarget(server))
      .get(`${callback.pathname}${callback.search}`)
      .set("Cookie", signIn.headers["set-cookie"] as string[])
      .set("Origin", "http://localhost:3000").expect(302);
    const cookies = session.headers["set-cookie"] as string[];
    expect(cookies).toBeTruthy();
    const created = await call("create", { completed: false, title: "OIDC tRPC todo" }, cookies).expect(200);
    const todo = (created.body.result?.data?.json ?? created.body.result?.data) as { id: string | number };
    await call("findAll", undefined, cookies).expect(200);
    await call("update", { data: { completed: true }, id: todo.id }, cookies).expect(200);
    await call("delete", { id: todo.id }, cookies).expect(200);
  });
