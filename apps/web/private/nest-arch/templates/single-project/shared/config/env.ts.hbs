import "dotenv/config";
import { createEnv } from "@t3-oss/env-core";
import { z } from "zod";

export const env = createEnv({
  /**
   * By default, this library will feed the environment variables directly to
   * the Zod validator.
   *
   * This means that if you have an empty string for a value that is supposed
   * to be a number (e.g. `PORT=` in a ".env" file), Zod will incorrectly flag
   * it as a type mismatch violation. Additionally, if you have an empty string
   * for a value that is supposed to be a string with a default value (e.g.
   * `DOMAIN=` in an ".env" file), the default value will never be applied.
   *
   * In order to solve these issues, we recommend that all new projects
   * explicitly specify this option as true.
   */
  emptyStringAsUndefined: true,

  /**
   * What object holds the environment variables at runtime. This is usually
   * `process.env` or `import.meta.env`.
   */
  runtimeEnv: process.env,

  server: {
    CORS_ORIGIN: z.string().default("*"),
    {{#if (includes microservices "grpc")}}
    GRPC_URL: z.string().default("0.0.0.0:5000"),
    {{/if}}
    {{#if (includes microservices "kafka")}}
    KAFKA_BROKER: z.string().default("127.0.0.1:9092"),
    {{/if}}
    {{#if (or (includes microservices "redis") (includes microservices "mqtt") (includes microservices "nats") (includes microservices "rabbitmq") (includes microservices "kafka") (includes microservices "grpc"))}}
    MICROSERVICE_PORT: z.string().transform(Number).default(3001),
    {{/if}}
    {{#if hasMongodb}}
    MONGODB_URL: z.url(),
    {{/if}}
    {{#if (includes microservices "mqtt")}}
    MQTT_URL: z.url().default("mqtt://127.0.0.1:1883"),
    {{/if}}
    {{#if hasMysql}}
    MYSQL_URL: z.url(),
    {{/if}}
    {{#if (includes microservices "nats")}}
    NATS_URL: z.url().default("nats://127.0.0.1:4222"),
    {{/if}}
    NODE_ENV: z
      .enum(["development", "production", "test"])
      .default("development"),
    PORT: z
      .string()
      .transform(Number)
      .default(3000),
    {{#if hasPostgres}}
    POSTGRES_URL: z.url(),
    {{/if}}
    {{#if (includes microservices "rabbitmq")}}
    RABBITMQ_URL: z.url().default("amqp://127.0.0.1:5672"),
    {{/if}}
    {{#if (includes microservices "redis")}}
    REDIS_URL: z.url().default("redis://127.0.0.1:6379"),
    {{/if}}
    {{#if hasSqlite}}
    SQLITE_PATH: z.string().default("sqlite.db"),
    {{/if}}
    {{#if hasSqlserver}}
    SQLSERVER_DATABASE: z.string().default("{{projectNameKebab}}_db"),
    SQLSERVER_ENCRYPT: z.string().transform((value) => value !== "false").default(true),
    SQLSERVER_HOST: z.string().default("localhost"),
    SQLSERVER_PASSWORD: z.string(),
    SQLSERVER_PORT: z.string().transform(Number).default(1433),
    SQLSERVER_TRUST_SERVER_CERTIFICATE: z.string().transform((value) => value === "true").default(false),
    SQLSERVER_USER: z.string(),
    {{/if}}
    TRUSTED_PROXY_IPS: z.string().default("{{#each trustedProxyIps}}{{#unless @first}},{{/unless}}{{this}}{{/each}}"),
    {{#if hasGraphql}}
    GRAPHQL_PLAYGROUND: z
      .string()
      .transform((val) => val === "true")
      .default(true),
    {{/if}}
    {{#if (eq auth "passport")}}
    {{#if hasDatabase}}
    JWT_ACCESS_SECRET: z.string().min(32),
    JWT_ISSUER: z.string().default("{{projectName}}"),
    JWT_AUDIENCE: z.string().default("{{projectName}}-api"),
    JWT_KEY_ID: z.string().default("primary"),
    JWT_REFRESH_SECRET: z.string().min(32),
    {{else}}
    OIDC_JWKS_URI: z.url(),
    OIDC_ISSUER: z.url(),
    OIDC_AUDIENCE: z.string().min(1),
    {{/if}}
    {{/if}}
    {{#if (or (eq auth "better-auth") (eq auth "better-auth:stateless"))}}
    BETTER_AUTH_SECRET: z.string().min(32),
    BETTER_AUTH_URL: z.url(),
    {{#if (eq auth "better-auth:stateless")}}
    OIDC_PROVIDER_ID: z.string().min(1),
    OIDC_CLIENT_ID: z.string().min(1),
    OIDC_CLIENT_SECRET: z.string().min(1),
    OIDC_DISCOVERY_URL: z.url(),
    {{/if}}
    {{/if}}
  },
});
