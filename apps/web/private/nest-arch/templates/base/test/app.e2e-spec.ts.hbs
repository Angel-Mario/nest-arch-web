  const oidcOrigin = "http://127.0.0.1:4010";
  const { privateKey, publicKey } = generateKeyPairSync("rsa", { modulusLength: 2048 });
  const publicJwk = publicKey.export({ format: "jwk" });
  let authorizationNonce = "";
  let oidcServer: ReturnType<typeof createServer>;

  function signIdToken(nonce: string): string {
    const encodedHeader = Buffer.from(JSON.stringify({ alg: "RS256", kid: "scenario-key", typ: "JWT" })).toString("base64url");
    const encodedPayload = Buffer.from(JSON.stringify({ aud: "generated-scenario-client", email: "oidc-scenario@example.com", exp: Math.floor(Date.now() / 1000) + 300, iat: Math.floor(Date.now() / 1000), iss: oidcOrigin, name: "OIDC Scenario", nonce, sub: "oidc-scenario-user" })).toString("base64url");
    const signingInput = `${encodedHeader}.${encodedPayload}`;
    const signer = createSign("RSA-SHA256");
    signer.update(signingInput);
    signer.end();
    return `${signingInput}.${signer.sign(privateKey).toString("base64url")}`;
  }

  async function startOidcFixture(): Promise<void> {
    oidcServer = createServer((incomingRequest, response) => {
      const url = new URL(incomingRequest.url ?? "/", oidcOrigin);
      if (url.pathname === "/.well-known/openid-configuration") {
        response.setHeader("content-type", "application/json");
        response.end(JSON.stringify({ authorization_endpoint: `${oidcOrigin}/authorize`, issuer: oidcOrigin, jwks_uri: `${oidcOrigin}/jwks`, token_endpoint: `${oidcOrigin}/token`, userinfo_endpoint: `${oidcOrigin}/userinfo` }));
        return;
      }
      if (url.pathname === "/jwks") {
        response.setHeader("content-type", "application/json");
        response.end(JSON.stringify({ keys: [{ ...publicJwk, alg: "RS256", kid: "scenario-key", use: "sig" }] }));
        return;
      }
      if (url.pathname === "/authorize") {
        authorizationNonce = url.searchParams.get("nonce") ?? "";
        const redirect = new URL(url.searchParams.get("redirect_uri") ?? "");
        redirect.searchParams.set("code", "scenario-code");
        redirect.searchParams.set("state", url.searchParams.get("state") ?? "");
        response.writeHead(302, { location: redirect.toString() });
        response.end();
        return;
      }
      if (url.pathname === "/token") {
        let body = "";
        incomingRequest.on("data", (chunk: Buffer) => { body += chunk.toString(); });
        incomingRequest.on("end", () => {
          response.setHeader("content-type", "application/json");
          response.end(JSON.stringify({ access_token: "scenario-access-token", id_token: signIdToken(authorizationNonce), token_type: "Bearer" }));
        });
        return;
      }
      if (url.pathname === "/userinfo") {
        response.setHeader("content-type", "application/json");
        response.end(JSON.stringify({ email: "oidc-scenario@example.com", name: "OIDC Scenario", sub: "oidc-scenario-user" }));
        return;
      }
      response.writeHead(404);
      response.end();
    });
    oidcServer.listen(4010, "127.0.0.1");
    await once(oidcServer, "listening");
  }
