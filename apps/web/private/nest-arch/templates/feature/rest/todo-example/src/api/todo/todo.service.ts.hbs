import { BadRequestException, Injectable, NotFoundException } from "@nestjs/common";
import { ObjectId, type WithId } from "mongodb";
import { DbService } from "../../database/db.service.js";
import { CreateTodoDto } from "./dto/create-todo.dto.js";
import { UpdateTodoDto } from "./dto/update-todo.dto.js";
interface TodoDocument { title: string; completed: boolean; description?: string; }
const serialize = ({ _id, ...todo }: WithId<TodoDocument>) => ({ ...todo, id: _id.toHexString() });
function objectId(id: string): ObjectId {
  if (!/^[a-f0-9]{24}$/iu.test(id)) throw new BadRequestException("Invalid todo identifier");
  return new ObjectId(id);
}
@Injectable()
export class TodoService {
  constructor(private readonly db: DbService) {}
  private get todos() { return this.db.raw.mongo.collection<TodoDocument>("todos"); }
  async findAll() {
    const todos = await this.todos.find().sort({ _id: 1 }).limit(100).toArray();
    return todos.map(serialize);
  }
  async create(input: CreateTodoDto) {
    const todo = { title: input.title, completed: input.completed ?? false, ...(input.description === undefined ? {} : { description: input.description }) };
    const result = await this.todos.insertOne(todo);
    return { ...todo, id: result.insertedId.toHexString() };
  }
{{#if isPrisma8}}
  update(id: string, input: UpdateTodoDto) {
{{else}}
  async update(id: string, input: UpdateTodoDto) {
{{/if}}
    const todo = await this.todos.findOneAndUpdate({ _id: objectId(id) }, { $set: input }, { returnDocument: "after" });
    if (!todo) throw new NotFoundException("Todo not found");
    return serialize(todo);
  }
  async delete(id: string) {
    const result = await this.todos.deleteOne({ _id: objectId(id) });
    if (result.deletedCount === 0) throw new NotFoundException("Todo not found");
    return { message: "Todo deleted successfully" };
  }
}
