import { BadRequestException, Injectable, NotFoundException } from "@nestjs/common";
import { ObjectId } from "mongodb";
import type { Document, WithId } from "mongodb";

import { DbService } from "../../database/db.service.js";
import { CreateTodoDto } from "./dto/create-todo.dto.js";
import { UpdateTodoDto } from "./dto/update-todo.dto.js";

interface TodoDocument extends Document {
  authorId?: string;
  completed: boolean;
  createdAt: Date;
  description?: string;
  title: string;
  updatedAt: Date;
}

const serialize = ({ _id, ...todo }: WithId<TodoDocument>) => ({
  ...todo,
  id: _id.toHexString(),
});

function objectId(id: string): ObjectId {
  if (!/^[a-f0-9]{24}$/iu.test(id)) {
    throw new BadRequestException("Invalid todo identifier");
  }
  return new ObjectId(id);
}

@Injectable()
export class TodoService {
  constructor(private readonly db: DbService) {}

  private get todos() {
    return this.db.mongo.collection<TodoDocument>("todos");
  }

  async findAll(ownerId?: string) {
    const todos = await this.todos
      .find(ownerId === undefined ? {} : { authorId: ownerId })
      .sort({ _id: 1 })
      .limit(100)
      .toArray();
    return todos.map(serialize);
  }

  async create(input: CreateTodoDto, ownerId?: string) {
    const now = new Date();
    const todo = {
      completed: input.completed ?? false,
      createdAt: now,
      ...(ownerId === undefined ? {} : { authorId: ownerId }),
      ...(input.description === undefined ? {} : { description: input.description }),
      title: input.title,
      updatedAt: now,
    };
    const result = await this.todos.insertOne(todo);
    return { ...todo, id: result.insertedId.toHexString() };
  }

  async update(id: string, input: UpdateTodoDto, ownerId?: string) {
    const _id = objectId(id);
    const ownerFilter = ownerId === undefined ? {} : { authorId: ownerId };
    await this.todos.updateOne({ _id, ...ownerFilter }, { $set: { ...input, updatedAt: new Date() } });
    const todo = await this.todos.findOne({ _id, ...ownerFilter });
    if (!todo) {
      throw new NotFoundException("Todo not found");
    }
    return serialize(todo);
  }

  async delete(id: string, ownerId?: string) {
    const result = await this.todos.deleteOne({ _id: objectId(id), ...(ownerId === undefined ? {} : { authorId: ownerId }) });
    if (result.deletedCount === 0) {
      throw new NotFoundException("Todo not found");
    }
    return { message: "Todo deleted successfully" };
  }
}
