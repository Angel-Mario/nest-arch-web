{{#if (includes microservices "grpc")}}
import { fileURLToPath } from "node:url";
{{/if}}
{{#if (eq httpProvider "fastify")}}
import { FastifyAdapter, NestFastifyApplication } from "@nestjs/platform-fastify";
{{/if}}
{{#if (includes addons "nestjs-zod")}}
import { Logger } from "@nestjs/common";
import { ZodValidationPipe } from "nestjs-zod";
{{else}}
import { Logger, StandardSchemaValidationPipe } from "@nestjs/common";
{{/if}}
import { NestFactory } from "@nestjs/core";
import { Transport } from "@nestjs/microservices";
import type { MicroserviceOptions } from "@nestjs/microservices";

import { AppModule } from "./app.module.js";
import { env } from "./config/env.js";
{{#if swagger}}
import { createDocs } from "./docs/create-docs.js";
{{/if}}
{{#if (and swagger useSwaggerScalar)}}
import { apiReference } from "@scalar/nestjs-api-reference";
{{/if}}
{{#if (and swagger (eq useSwaggerScalar false))}}
import { SwaggerModule } from "@nestjs/swagger";
{{/if}}
{{#if (and swagger (or (eq auth "better-auth") (eq auth "better-auth:stateless")))}}
import { AuthService } from "@thallesp/nestjs-better-auth";
{{/if}}

async function bootstrap() {
  const trustedProxyIps = env.TRUSTED_PROXY_IPS.split(",").map((ip) => ip.trim()).filter(Boolean);
  const app = await NestFactory.create{{#if (eq httpProvider "fastify")}}<NestFastifyApplication>(AppModule, new FastifyAdapter({ trustProxy: trustedProxyIps })){{else}}(AppModule){{/if}};
  {{#unless (eq httpProvider "fastify")}}
  if (trustedProxyIps.length > 0) {
    app.getHttpAdapter().getInstance().set("trust proxy", trustedProxyIps);
  }
  {{/unless}}
  app.enableCors({ origin: env.CORS_ORIGIN });
  app.setGlobalPrefix("api");
  {{#if (includes addons "nestjs-zod")}}
  app.useGlobalPipes(new ZodValidationPipe());
  {{else}}
  app.useGlobalPipes(new StandardSchemaValidationPipe());
  {{/if}}
  app.enableShutdownHooks();

  app.connectMicroservice<MicroserviceOptions>({
    options: {
      {{#if (includes microservices "kafka")}}
      client: { brokers: [env.KAFKA_BROKER ?? "127.0.0.1:9092"] },
      {{/if}}
      {{#if (includes microservices "grpc")}}
      package: "app",
      protoPath: fileURLToPath(new URL("proto/app.proto", import.meta.url)),
      url: env.GRPC_URL ?? "0.0.0.0:5000",
      {{/if}}
      {{#if (includes microservices "rabbitmq")}}
      queue: "ping",
      queueOptions: { durable: false },
      urls: [env.RABBITMQ_URL ?? "amqp://127.0.0.1:5672"],
      {{/if}}
      {{#if (includes microservices "redis")}}
      host: new URL(env.REDIS_URL).hostname,
      port: Number(new URL(env.REDIS_URL).port || 6379),
      {{/if}}
      {{#if (includes microservices "nats")}}
      servers: [env.NATS_URL ?? "nats://127.0.0.1:4222"],
      {{/if}}
      {{#if (includes microservices "mqtt")}}
      url: env.MQTT_URL ?? "mqtt://127.0.0.1:1883",
      {{/if}}
      {{#unless (or (includes microservices "redis") (includes microservices "mqtt") (includes microservices "nats") (includes microservices "rabbitmq") (includes microservices "kafka") (includes microservices "grpc"))}}
      host: "0.0.0.0",
      port: env.MICROSERVICE_PORT,
      {{/unless}}
    },
    transport: {{#if (includes microservices "redis")}}Transport.REDIS{{else if (includes microservices "mqtt")}}Transport.MQTT{{else if (includes microservices "nats")}}Transport.NATS{{else if (includes microservices "rabbitmq")}}Transport.RMQ{{else if (includes microservices "kafka")}}Transport.KAFKA{{else if (includes microservices "grpc")}}Transport.GRPC{{else}}Transport.TCP{{/if}},
  });

  {{#if swagger}}
  if (env.NODE_ENV === "development") {
    const docsPath = "/docs";
    {{#if useSwaggerScalar}}
    app.use(
      docsPath,
      apiReference({
        content: await createDocs(app, {
          description: "{{description}}",
          integrations: {
            {{#if (or (eq auth "better-auth") (eq auth "better-auth:stateless"))}}
            betterAuth: {
              auth: app.get(AuthService).instance,
              pathPrefix: "/api/auth",
            },
            {{/if}}
            {{#if (includes apis "trpc")}}
            trpc: {
              pathPrefix: "/trpc",
              routerFilePath: "./{{trpcGeneratePath}}/server.ts",
            },
            {{/if}}
            zod: {
              withFastify: {{#if (eq httpProvider "fastify")}}true{{else}}false{{/if}},
            },
          },
          title: "{{projectNamePascalCase}} API",
          version: "1.0.0",
        }),
        pageTitle: "{{projectNamePascalCase}} API Docs",
        theme: "default",
        {{#if (eq httpProvider "fastify")}}withFastify: true,{{/if}}
      }),
    );
    {{else}}
    const document = await createDocs(app, {
      description: "{{description}}",
      integrations: {
        {{#if (or (eq auth "better-auth") (eq auth "better-auth:stateless"))}}
        betterAuth: {
          auth: app.get(AuthService).instance,
          pathPrefix: "/api/auth",
        },
        {{/if}}
        {{#if (includes apis "trpc")}}
        trpc: {
          routerFilePath: "./{{trpcGeneratePath}}/server.ts",
          pathPrefix: "/trpc",
        },
        {{/if}}
        zod: {
          withFastify: {{#if (eq httpProvider "fastify")}}true{{else}}false{{/if}},
        },
      },
      title: "{{projectNamePascalCase}} API",
      version: "1.0.0",
    });
    SwaggerModule.setup(docsPath, app, document);
    {{/if}}
    Logger.log(`Swagger documentation available at http://localhost:${env.PORT ?? 3000}${docsPath}`, "SwaggerDocs");
  }
  {{/if}}

  await app.startAllMicroservices();
  await app.listen(env.PORT ?? 3000, "0.0.0.0");
  {{#if hasRest}}
  Logger.log(`Started backend server on http://localhost:${env.PORT ?? 3000}/api`, "Main");
  {{else if hasTrpc}}
  Logger.log(`Started trpc server on http://localhost:${env.PORT ?? 3000}/trpc`, "Main");
  {{else}}
  Logger.log(`Started server on http://localhost:${env.PORT ?? 3000}`, "Main");
  {{/if}}
}
await bootstrap();
