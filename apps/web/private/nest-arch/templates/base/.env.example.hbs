# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Comma-separated trusted reverse proxy IP addresses or CIDRs
TRUSTED_PROXY_IPS={{#each trustedProxyIps}}{{#unless @first}},{{/unless}}{{this}}{{/each}}

{{#if (eq architecture "nest-microservice")}}
# Microservice transport
MICROSERVICE_PORT=3001
{{/if}}
{{#if (includes microservices "redis")}}
REDIS_URL=redis://127.0.0.1:6379
{{/if}}
{{#if (includes microservices "mqtt")}}
MQTT_URL=mqtt://127.0.0.1:1883
{{/if}}
{{#if (includes microservices "nats")}}
NATS_URL=nats://127.0.0.1:4222
{{/if}}
{{#if (includes microservices "rabbitmq")}}
RABBITMQ_URL=amqp://127.0.0.1:5672
{{/if}}
{{#if (includes microservices "kafka")}}
KAFKA_BROKER=127.0.0.1:9092
{{/if}}
{{#if (includes microservices "grpc")}}
GRPC_URL=0.0.0.0:5000
{{/if}}

{{#if hasDatabase}}
# Database
{{/if}}
{{#if hasPostgres}}
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/{{projectNameKebab}}_db?schema=public
{{/if}}
{{#if hasMysql}}
MYSQL_URL=mysql://root:mysql@localhost:3306/{{projectNameKebab}}_db
{{/if}}
{{#if hasSqlite}}
SQLITE_PATH=./src/database/dev.db
{{/if}}
{{#if hasSqlserver}}
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE={{projectNameKebab}}_db
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=DevOnly_Strong_Password_2026!X9
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
{{/if}}
{{#if hasMongodb}}
MONGODB_URL=mongodb://localhost:27017/{{projectNameKebab}}_db
{{/if}}

{{#if hasGraphql}}
# GraphQL
GRAPHQL_PLAYGROUND=true

{{/if}}
{{#if (and (eq auth "passport") (not hasDatabase))}}
# External identity provider (RS256 JWKS)
OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=generated-resource-server
{{else if (eq auth "passport")}}
# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-secret-at-least-32-characters-long
{{#if hasDatabase}}
JWT_REFRESH_SECRET=change-me-to-a-different-random-secret-at-least-32-characters
{{/if}}
{{/if}}
{{#if (or (eq auth "better-auth") (eq auth "better-auth:stateless"))}}
# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
{{#if (eq auth "better-auth:stateless")}}
# OIDC provider; register http://localhost:3000/api/auth/callback/$OIDC_PROVIDER_ID as its callback URL
OIDC_PROVIDER_ID=company-oidc
OIDC_CLIENT_ID=replace-with-provider-client-id
OIDC_CLIENT_SECRET=replace-with-provider-client-secret
OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
{{/if}}
{{/if}}
