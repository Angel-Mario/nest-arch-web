import { BadRequestException, Injectable, NotFoundException } from "@nestjs/common";
import { ObjectId } from "mongodb";
import { DbService } from "../../database/db.service.js";
import { Todo } from "../../database/entities/todo.entity.js";
import { CreateTodoDto } from "./dto/create-todo.dto.js";
import { UpdateTodoDto } from "./dto/update-todo.dto.js";

function objectId(id: string): ObjectId {
  if (!/^[a-f0-9]{24}$/iu.test(id)) {
    throw new BadRequestException("Invalid todo identifier");
  }
  return new ObjectId(id);
}

const serialize = ({ id, ...todo }: Todo) => ({ ...todo, id: id.toHexString() });

@Injectable()
export class TodoService {
  constructor(private readonly db: DbService) {}

  private get todos() {
    return this.db.typeorm.getMongoRepository(Todo);
  }

  async findAll() {
    return (await this.todos.find({ take: 100 })).map(serialize);
  }

  async create(input: CreateTodoDto) {
    const todo = this.todos.create({ ...input, completed: input.completed ?? false });
    return serialize(await this.todos.save(todo));
  }

  async update(id: string, input: UpdateTodoDto) {
    const todo = await this.todos.findOneBy({ id: objectId(id) });
    if (!todo) {
      throw new NotFoundException("Todo not found");
    }
    return serialize(await this.todos.save(this.todos.merge(todo, input)));
  }

  async delete(id: string) {
    const result = await this.todos.deleteOne({ _id: objectId(id) });
    if (result.deletedCount === 0) {
      throw new NotFoundException("Todo not found");
    }
    return { message: "Todo deleted successfully" };
  }
}
