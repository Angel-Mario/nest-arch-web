      .send({ title: "OIDC protected todo", completed: false }).expect(201);
    const { id } = created.body;
    const list = await request(getRequestTarget(server)).get("/todos")
      .set("Cookie", cookies).expect(200);
    expect(list.body).toEqual(expect.arrayContaining([expect.objectContaining({ id })]));
    await request(getRequestTarget(server)).put(`/todos/${id}`)
      .set("Cookie", cookies).send({ completed: true }).expect(200);
    await request(getRequestTarget(server)).delete(`/todos/${id}`)
      .set("Cookie", cookies).expect(200);
  });
{{/if}}

{{#if (and isBetterAuth hasRateLimiting)}}
  it("keeps normal sign-in usable and throttles repeated authentication requests", async () => {
    const server = app.getHttpServer();
{{#if (eq auth "better-auth:stateless")}}
    const origin = "http://localhost:3000";
    const signIn = () => request(getRequestTarget(server))
      .post("/api/auth/sign-in/social")
      .set("Origin", origin)
      .send({ callbackURL: "/", provider: "scenario-oidc" });
    await signIn().expect(200);
    const responses = await Promise.all(
      Array.from({ length: 80 }, () => signIn())
    );
    expect(responses.some((response) => response.status === 429)).toBe(true);
{{else}}
    const origin = "http://localhost:3000";
    const email = `ratelimit-${Date.now()}@example.com`;
    const password = "Scenario-password-123!";
    await request(getRequestTarget(server)).post("/api/auth/sign-up/email")
      .set("Origin", origin).send({ email, password, name: "Rate limit" }).expect(200);
    await request(getRequestTarget(server)).post("/api/auth/sign-in/email")
      .set("Origin", origin).send({ email, password }).expect(200);
    const responses = await Promise.all(
      Array.from({ length: 80 }, () =>
        request(getRequestTarget(server))
          .post("/api/auth/sign-in/email")
          .set("Origin", origin)
          .send({ email: "rate-limited@example.com", password: "wrong-password" })
      )
    );
    expect(responses.some((response) => response.status === 429)).toBe(true);
{{/if}}
  }, 30_000);
{{/if}}

  it("rejects unsupported methods", async () => {
    await request(getRequestTarget()).post("/").send({ unexpected: true }).expect(404);
