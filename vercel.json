{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "buildCommand": "pnpm run build",
      "devCommand": "pnpm exec next dev"
    },
    "fumadocs": {
      "root": "apps/fumadocs",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "buildCommand": "pnpm run build",
      "devCommand": "pnpm exec next dev"
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": { "service": "fumadocs" }
    },
    {
      "source": "/docs/:path*",
      "destination": { "service": "fumadocs" }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
