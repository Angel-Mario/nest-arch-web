{{#if (and hasMongodb (or useRawSql useTypeorm))}}
import type { Collection, Document } from "mongodb";
{{/if}}
{{#if (or hasPostgres hasMysql hasSqlite hasSqlserver)}}
export interface ISqlAdapter<TClient = unknown> {
  query: <T = unknown>(sql: string, params?: unknown[]) => Promise<T[]>;
  execute: (sql: string, params?: unknown[]) => Promise<unknown>;
  getClient: () => TClient;
}
{{/if}}

{{#if hasMongodb}}
export interface IMongoAdapter<TClient = unknown> {
{{#if (or useRawSql useTypeorm)}}
  collection: <T = unknown>(name: string) => Collection<T & Document>;
{{else}}
  collection: <T = unknown>(name: string) => T;
{{/if}}
  getClient: () => TClient;
}
{{/if}}
