import { Inject, Injectable } from "@nestjs/common";
import type { OnModuleDestroy } from "@nestjs/common";
import type { DataSource } from "typeorm";
import type { IMongoAdapter } from "../interfaces/db-adapter.interface.js";

@Injectable()
export class TypeormMongoAdapter implements IMongoAdapter<DataSource>, OnModuleDestroy {
  constructor(@Inject("TYPEORM_DATA_SOURCE") private readonly dataSource: DataSource) {}

  collection<T = unknown>(name: string): T {
    return this.dataSource.getMongoRepository(name) as T;
  }

  getClient(): DataSource {
    return this.dataSource;
  }

  async onModuleDestroy(): Promise<void> {
    if (this.dataSource.isInitialized) {
      await this.dataSource.destroy();
    }
  }
}
