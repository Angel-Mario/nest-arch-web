      const operation = procedure === "findAll"
        ? request(getRequestTarget(server)).get("/trpc/todoRouter.findAll")
        : request(getRequestTarget(server)).post(`/trpc/todoRouter.${procedure}`);
      if (cookies) operation.set("Cookie", cookies);
