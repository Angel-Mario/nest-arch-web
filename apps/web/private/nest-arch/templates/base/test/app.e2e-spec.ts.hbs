{{#if (and isPassportAuth hasTodoExample hasDatabase hasRest)}}
  it("enforces REST todo ownership across two Passport users", async () => {
    const server = app.getHttpServer();
    const password = "Scenario-password-123!";
    async function register(prefix: string) {
      const email = `${prefix}-${Date.now()}-${Math.random().toString(16).slice(2)}@example.com`;
      await request(getRequestTarget(server)).post({{#if (and usePrisma hasRest (not hasMongodb))}}"/auth/register"{{else}}"/auth/signup"{{/if}})
        .send({ email, password }).expect(201);
      const response = await request(getRequestTarget(server)).post("/auth/login")
        .send({ email, password }).expect(200);
      expect(response.body.accessToken).toBeTruthy();
      return response.body.accessToken as string;
    }
    const alice = await register("passport-alice");
    const bob = await register("passport-bob");
    const created = await request(getRequestTarget(server)).post("/todos")
      .set("Authorization", `Bearer ${alice}`)
      .send({ title: "Private Passport todo", completed: false }).expect(201);
    const todo = Array.isArray(created.body) ? created.body[0] : created.body;
    const { id } = todo;
    const bobList = await request(getRequestTarget(server)).get("/todos")
      .set("Authorization", `Bearer ${bob}`).expect(200);
    expect(bobList.body).not.toEqual(
      expect.arrayContaining([expect.objectContaining({ id })])
    );
    await request(getRequestTarget(server)).put(`/todos/${id}`)
      .set("Authorization", `Bearer ${bob}`)
      .send({ completed: true }).expect(404);
    await request(getRequestTarget(server)).delete(`/todos/${id}`)
      .set("Authorization", `Bearer ${bob}`).expect(404);
    const aliceList = await request(getRequestTarget(server)).get("/todos")
      .set("Authorization", `Bearer ${alice}`).expect(200);
    expect(aliceList.body).toEqual(
      expect.arrayContaining([
        expect.objectContaining({ id, completed: false }),
      ])
    );
  });
{{/if}}

{{#if (and isPassportAuth (not hasDatabase) hasTodoExample hasRest)}}
  it("protects external-identity REST todos and isolates owners", async () => {
    const server = app.getHttpServer();
    await request(getRequestTarget(server)).get("/todos").expect(401);
    const aliceToken = signAccessToken();
    const bobToken = signAccessToken({ sub: "external-user-2" });
    const created = await request(getRequestTarget(server))
      .post("/todos")
      .set("Authorization", `Bearer ${aliceToken}`)
      .send({ title: "External identity todo", completed: false })
      .expect(201);
    const todo = created.body as { id: string };
    const bobTodos = await request(getRequestTarget(server))
      .get("/todos")
      .set("Authorization", `Bearer ${bobToken}`)
      .expect(200);
    expect(bobTodos.body).toEqual([]);
    const aliceTodos = await request(getRequestTarget(server))
      .get("/todos")
      .set("Authorization", `Bearer ${aliceToken}`)
      .expect(200);
    expect(aliceTodos.body).toEqual(
      expect.arrayContaining([expect.objectContaining({ id: todo.id })])
    );
    await request(getRequestTarget(server))
      .put(`/todos/${todo.id}`)
      .set("Authorization", `Bearer ${aliceToken}`)
      .send({ completed: true })
      .expect(200);
    await request(getRequestTarget(server))
      .delete(`/todos/${todo.id}`)
      .set("Authorization", `Bearer ${aliceToken}`)
      .expect(200);
  });
