allowBuilds:
  "@nestjs/core": true
{{#if swagger}}
  "@scarf/scarf": true
{{/if}}
{{#if hasGraphql}}
  "@apollo/protobufjs": true
{{/if}}
{{#if (and (eq auth "passport") hasDatabase)}}
  bcrypt: true
{{/if}}
{{#if hasSqlite}}
  better-sqlite3: true
{{/if}}
{{#if hasTrpc}}
peerDependencyRules:
  allowedVersions:
    "nestjs-trpc>@nestjs/common": "^12.0.0"
    "nestjs-trpc>@nestjs/core": "^12.0.0"
{{/if}}
catalog:
  dotenv: ^17.2.2
