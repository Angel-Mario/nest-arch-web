import { Module } from "@nestjs/common";
import { buildSchema } from "drizzle-graphql";
{{#if isMonorepo}}
import { db } from "@repo/db";
{{else}}
import { env } from "../../../config/env.js";
  {{#if hasPostgres}}
import { drizzle } from "drizzle-orm/node-postgres";
import { Pool } from "pg";
  {{/if}}
  {{#if hasMysql}}
import { drizzle } from "drizzle-orm/mysql2";
import mysql from "mysql2";
  {{/if}}
  {{#if hasSqlite}}
import { drizzle } from "drizzle-orm/better-sqlite3";
import Database from "better-sqlite3";
  {{/if}}
import * as dbSchema from "../../../database/orm/drizzle/schema.js";
{{/if}}

const schema = buildSchema({{#if isMonorepo}}db{{else}}
  {{#if hasPostgres}}
  drizzle(new Pool({ connectionString: env.POSTGRES_URL }), { schema: dbSchema })
  {{/if}}
  {{#if hasMysql}}
  drizzle(mysql.createPool(env.MYSQL_URL), { mode: "default", schema: dbSchema })
  {{/if}}
  {{#if hasSqlite}}
  drizzle(new Database(env.SQLITE_PATH), { schema: dbSchema })
  {{/if}}
{{/if}});


@Module({
  providers: [
    {
      provide: "DRIZZLE_GRAPHQL_SCHEMA",
      useValue: schema,
    },
  ],
  exports: ["DRIZZLE_GRAPHQL_SCHEMA"],
})
export class DrizzleGraphqlModule {}
