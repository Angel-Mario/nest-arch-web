  it("throttles repeated GraphQL requests to 429", async () => {
    app.getHttpServer().setMaxListeners(100);
    const responses = await Promise.all(
      Array.from({ length: 80 }, () =>
        request(getRequestTarget()).post("/graphql").send({ query: "{ hello }" })
      )
    );
    const lastResponse = responses.at(-1);
    const responseSummary = lastResponse
      ? JSON.stringify({ errors: lastResponse.body.errors, status: lastResponse.status })
      : "GraphQL rate-limit probe produced no responses";
    const throttled = responses.some(
      (response) =>
        response.status === 429 ||
        response.body.errors?.some(
          (error: { message?: string; extensions?: { originalError?: { statusCode?: number } } }) =>
            error.extensions?.originalError?.statusCode === 429 ||
            error.message?.includes("ThrottlerException: Too Many Requests") === true
        ) === true
    );
    expect(throttled, responseSummary).toBe(true);
  }, 30_000);
{{/if}}

