import {
  Column,
  Entity,
  {{#if hasMongodb}}
  ObjectIdColumn,
  {{else}}
  PrimaryGeneratedColumn,
  {{/if}}
} from "typeorm";
{{#if hasMongodb}}
import type { ObjectId } from "mongodb";
{{/if}}

@Entity("users")
export class UserEntity {
  {{#if hasMongodb}}
  @ObjectIdColumn()
  id: ObjectId;
  {{else}}
  @PrimaryGeneratedColumn("uuid")
  id: string;
  {{/if}}

  @Column({ type: "varchar"{{#unless hasMongodb}}, unique: true{{/unless}} })
  email: string;

  @Column({ type: "varchar", nullable: true })
  firstname: string | null;

  @Column({ type: "varchar", nullable: true })
  lastname: string | null;

  @Column({ type: "varchar" })
  password: string;

  @Column({ type: "varchar", default: "USER" })
  role: string;
}
