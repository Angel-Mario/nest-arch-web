```

{{#if hasTrpcAndAuth}}
### Router Example (with Auth)

Routers are defined using the `@Router` decorator from `nestjs-trpc`. **Router names must start with a lowercase letter.**

```typescript
import { Router, Query, UseMiddlewares, Ctx } from "nestjs-trpc";
import z from "zod";

import { AppService } from "./app.service.js";
import type { UserSession } from "./auth/auth.js";
import { AuthTRPCMiddleware } from "./libs/middlewares/auth.trpc.middleware.js";
import type { InnerContext } from "./libs/trpc/inner.context.js";

@Router({ alias: "appRouter" })
export class AppRouterClass {
  constructor(private readonly appService: AppService) {}

  @Query()
  @UseMiddlewares(AuthTRPCMiddleware)
  testAuth(@Ctx() ctx: InnerContext): UserSession {
    return ctx.session!;
  }

  @Query({ output: z.string() })
  getHello(): string {
    return this.appService.getHello();
  }
}
```
{{else}}
