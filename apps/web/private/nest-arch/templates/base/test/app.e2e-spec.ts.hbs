{{#if (and hasTrustedProxy isPassportAuth hasRateLimiting hasDatabase)}}
  it("isolates rate limits by client IP behind a trusted reverse proxy", async () => {
    const appServer = app.getHttpServer();
    const email = `passport-proxy-${Date.now()}@example.com`;
    const password = "Scenario-password-123!";
    await request(getRequestTarget(appServer)).post({{#if (and usePrisma hasRest (not hasMongodb))}}"/auth/register"{{else}}"/auth/signup"{{/if}}).send({ email, password }).expect(201);
{{#unless (eq httpProvider "fastify")}}
    await new Promise<void>((resolve) => appServer.listen(0, "127.0.0.1", resolve));
{{/unless}}
    const appAddress = appServer.address();
    if (!appAddress || typeof appAddress === "string") {
      throw new Error("Application did not bind a TCP port for the proxy scenario");
    }

    const proxy = createServer((incoming, outgoing) => {
      const forwardedClientIp = incoming.headers["x-scenario-client-ip"]?.toString() ?? "198.51.100.10";
      const upstream = httpRequest({
        headers: { ...incoming.headers, "x-forwarded-for": forwardedClientIp },
        hostname: "127.0.0.1",
        method: incoming.method,
        path: incoming.url,
        port: appAddress.port,
      }, (upstreamResponse) => {
        outgoing.writeHead(upstreamResponse.statusCode ?? 502, upstreamResponse.headers);
        upstreamResponse.pipe(outgoing);
      });
      upstream.on("error", () => {
        outgoing.writeHead(502);
        outgoing.end();
      });
      incoming.pipe(upstream);
    });
    await new Promise<void>((resolve) => proxy.listen(0, "127.0.0.1", resolve));
    const proxyAddress = proxy.address();
    if (!proxyAddress || typeof proxyAddress === "string") {
      throw new Error("Reverse proxy did not bind a TCP port");
    }

    const proxyLogin = async (clientIp: string, suppliedPassword: string): Promise<number> => {
      const response = await fetch(`http://127.0.0.1:${proxyAddress.port}/auth/login`, {
        body: JSON.stringify({ email, password: suppliedPassword }),
        headers: {
          "content-type": "application/json",
          "x-scenario-client-ip": clientIp,
        },
        method: "POST",
      });
      return response.status;
    };

    expect(await proxyLogin("198.51.100.10", password)).toBe(200);
    const invalidAttempts = await Promise.all(
      Array.from({ length: 80 }, () => proxyLogin("198.51.100.10", "Invalid-password-123!"))
    );
    expect(invalidAttempts).toContain(429);
    expect(await proxyLogin("198.51.100.20", password)).toBe(200);

    await new Promise<void>((resolve, reject) => proxy.close((error) => error ? reject(error) : resolve()));
    await app.close();
  }, 30_000);
{{/if}}

